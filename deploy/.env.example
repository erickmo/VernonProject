# Copy of the keys deploy/configure.py writes. NO VALUES THAT MATTER LIVE HERE —
# this file is committed, deploy/.env is not (see .gitignore).
#
# Generate the real one with:  python3 deploy/configure.py

SITE_NAME=vp.example.test
# private-network | other-device
DB_LOCATION=private-network
DB_HOST=10.0.0.10
DB_PORT=3306
DB_NAME=change_me
DB_USER=change_me
DB_PASSWORD=
# Absolute path INSIDE the container to your database's CA certificate. Strongly
# recommended when DB_LOCATION is other-device; mount it in via docker-compose.
DB_SSL_CA=
# attach = the database already exists and DB_USER owns it (default)
# create = build a new site; needs DB_ROOT_USER and DB_ROOT_PASSWORD passed ONLY
#          on the one `docker compose run` that creates it, never stored here
SETUP_MODE=attach
ADMIN_PASSWORD=
# The address your nginx reaches. Not 0.0.0.0 unless you mean every network.
BIND_ADDRESS=127.0.0.1
APP_PORT=8000
SOCKETIO_PORT=9000
